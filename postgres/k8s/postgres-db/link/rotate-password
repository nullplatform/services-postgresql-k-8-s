#!/bin/bash
# rotate-password — custom LINK action.
# Changes the database user's password (ALTER USER) and updates the link's
# attributes so the exported secret env var carries the new credential on the
# app's next deploy.

set -e
export WORKING_DIRECTORY_ORIGINAL="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
cd $WORKING_DIRECTORY_ORIGINAL

# Get service connection details
SERVICE_HOSTNAME=$ACTION_SERVICE_ATTRIBUTES_HOSTNAME
SERVICE_PORT=$ACTION_SERVICE_ATTRIBUTES_PORT
SERVICE_DBNAME=$ACTION_SERVICE_ATTRIBUTES_DBNAME
SECRET_NAME=$ACTION_SERVICE_ATTRIBUTES_K_8_S_SECRET_NAME

# Re export due encoding (new_password may carry special characters)
eval "echo $(np service-action export-action-data --format bash --bash-prefix ACTION)"

# The user whose password rotates comes from the link's attributes.
# Lowercased: legacy links may carry a mixed-case username attribute while the
# actual role (created unquoted) was folded to lowercase by Postgres.
DB_USERNAME=$(echo "$ACTION_LINK_ATTRIBUTES_USERNAME" | tr '[:upper:]' '[:lower:]')
NEW_PASSWORD="$ACTION_PARAMETERS_NEW_PASSWORD"

if [[ -z "$DB_USERNAME" ]]; then
  JSON_RESPONSE='{"error": "link has no username attribute — was the link created successfully?", "rotated": false}'
  np link action update --results "$JSON_RESPONSE"
  exit 1
fi

# MODO 1 — sin new_password (invocada desde la UI): generamos una clave nueva y
# la escribimos en VAULT. No tocamos la DB acá: el Vault Agent watcher detecta
# el cambio, dispara el webhook del workflow, y el workflow re-invoca esta
# action CON new_password (modo 2), que es la que altera la DB. Sin loop: la
# rama de Vault solo corre cuando NO hay parametro.
if [[ -z "$NEW_PASSWORD" ]]; then
  GENERATED="pwd$(uuidgen | tr -d '-' | tr '[:upper:]' '[:lower:]')"
  echo "MODO vault-rotate: escribiendo secret/db en Vault (la cascada hace el resto)"
  kubectl config use-context k3d-vault-demo >/dev/null 2>&1 || true
  kubectl exec -n default vault-0 -- vault kv put secret/db username=app password="$GENERATED" >/dev/null
  JSON_RESPONSE='{"rotated": true, "error": ""}'
  np link action update --results "$JSON_RESPONSE"
  exit 0
fi

# Get admin credentials from K8s secret
ADMIN_PASSWORD=$(kubectl get secret $SECRET_NAME -n postgres-db -o json | jq -r '.data["postgres-password"]' | base64 -d)

# Rotate the password in the database
echo "DEBUG rotate: user=$DB_USERNAME new_password_len=${#NEW_PASSWORD} host=$SERVICE_HOSTNAME db=$SERVICE_DBNAME"
ROTATE_QUERY="ALTER USER \"$DB_USERNAME\" WITH PASSWORD '$NEW_PASSWORD';"
../run_query_in_pod.sh "$SERVICE_HOSTNAME" "$SERVICE_PORT" "$SERVICE_DBNAME" "postgres" "$ADMIN_PASSWORD" "$ROTATE_QUERY" "ddl"
echo "DEBUG rotate: ALTER ejecutado, verificando login con la clave nueva..."
../run_query_in_pod.sh "$SERVICE_HOSTNAME" "$SERVICE_PORT" "$SERVICE_DBNAME" "$DB_USERNAME" "$NEW_PASSWORD" "SELECT 'rotated-login-ok';" "dml" || {
  JSON_RESPONSE='{"error": "post-rotate login verification failed", "rotated": false}'
  np link action update --results "$JSON_RESPONSE"
  exit 1
}

# Update link attributes: keep existing ones, overwrite password.
# The link's `password` attribute is exported as a secret env var, so the
# app picks up the new credential on its next deployment.
JSON_RESPONSE=$(echo $NP_ACTION_CONTEXT | jq ".notification.link.attributes + {
    username: \"$DB_USERNAME\",
    password: \"$NEW_PASSWORD\",
    rotated: true
}")

np link action update --results "$JSON_RESPONSE"
